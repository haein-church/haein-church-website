---
import { groups, menuUrl } from '../lib/onmam';
import branding from '../data/branding.json';
const path = Astro.url.pathname;
---
<div class="site-header">
  <div class="header-top">
    <a class="brand" href="/" aria-label="해인교회 홈"><img src={branding.logo} alt={branding.alt} width={branding.width} height={branding.height} fetchpriority="high"/><small>하나님을 사랑하고 이웃을 섬기는 교회</small></a>
    <nav class="account" aria-label="회원 메뉴"><a href="/boards/">전체 메뉴·검색</a><a href="/join/">가입신청</a><a href="/membership/">내 가입 상태</a><a href="/login/" id="loginNavBtn">로그인</a></nav>
  </div>
  <nav class="primary" id="primary-menu" aria-label="주요 메뉴">
    {groups.filter(group=>group.visible!==false).map(group => <details class="nav-group">
      <summary class:list={{active: path === `/sections/${group.slug}/` || group.children.some(item => path.startsWith(menuUrl(item)))}}>{group.name}<span aria-hidden="true">⌄</span></summary>
      <div class="submenu"><a class="group-overview" href={`/sections/${group.slug}/`}>{group.name} 전체보기 →</a>{group.children.filter(item=>item.visible!==false).map(item => <a href={menuUrl(item)} aria-current={path === menuUrl(item) ? 'page' : undefined}>{item.name}</a>)}</div>
    </details>)}
  </nav>
</div>
<script>
 const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('.nav-group'));
 menus.forEach(menu => {
   menu.addEventListener('toggle', () => { if (menu.open) menus.forEach(other => { if(other !== menu) other.open = false; }); });
   menu.addEventListener('keydown', event => { if(event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
 });
 document.addEventListener('click', event => { if (event.target instanceof Node && !menus.some(menu => menu.contains(event.target as Node))) menus.forEach(menu => menu.open = false); });
</script>
<style is:global>
 .brand{flex-direction:column!important;align-items:flex-start!important;gap:.5rem!important;letter-spacing:0!important}.brand img{display:block;width:220px;height:auto;object-fit:contain}.brand>small{font-size:.68rem;font-weight:400;color:#64748b;letter-spacing:0}
 .site-header{background:#fff;border-bottom:1px solid #dfe6ee;position:relative;z-index:100}.header-top{max-width:1200px;margin:auto;padding:1.5rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}.brand{display:flex;gap:.8rem;align-items:center;color:#193e65;font-size:1.65rem;font-weight:800;letter-spacing:-.05em}.brand>span:first-child{font-size:2.7rem;font-weight:400;color:#af824a}.brand small{display:block;font-size:.72rem;letter-spacing:0;font-weight:400;color:#64748b;margin-top:.3rem}.account{display:flex;gap:1rem;flex-wrap:wrap;font-size:.8rem;color:#526276}.account a:hover{color:#164e85;text-decoration:underline}.primary{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));max-width:1200px;margin:auto;padding:0 1.5rem}.nav-group{position:relative}.nav-group summary{list-style:none;cursor:pointer;padding:1rem .3rem;font-size:.93rem;text-align:center;font-weight:600;white-space:nowrap;border-bottom:3px solid transparent}.nav-group summary::-webkit-details-marker{display:none}.nav-group summary span{margin-left:.4rem;color:#728397}.nav-group[open] summary,.nav-group summary.active{color:#164e85;border-color:#b28a54;background:#f6f8fb}.submenu{position:absolute;top:100%;left:0;min-width:215px;max-height:65vh;overflow:auto;background:white;border:1px solid #e1e7ee;border-radius:0 0 10px 10px;box-shadow:0 12px 30px #173d7120;padding:.6rem}.nav-group:last-child .submenu{left:auto;right:0}.submenu a{display:block;padding:.7rem .85rem;font-size:.87rem;border-radius:5px}.submenu a:hover,.submenu a[aria-current]{background:#f0f5fb;color:#164e85}.submenu .group-overview{color:#164e85;font-weight:700;border-bottom:1px solid #e5eaf0;border-radius:0;margin-bottom:.4rem}
 @media(max-width:850px){.header-top{padding:1rem;align-items:flex-start;flex-wrap:wrap}.brand{font-size:1.4rem}.primary{grid-template-columns:repeat(4,minmax(0,1fr));padding:0 .5rem}.nav-group summary{font-size:.83rem;padding:.85rem .1rem}.nav-group:nth-child(4n) .submenu{left:auto;right:0}.submenu{min-width:190px}.account{font-size:.75rem;gap:.8rem}.brand small{font-size:.68rem}}
</style>
