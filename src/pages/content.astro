---
import Layout from '../layouts/Layout.astro';
---
<Layout title="교회 자료 - 해인교회"><main class="live-page" id="online-record"><p role="status">자료를 불러오는 중입니다.</p></main></Layout>
<style is:global>.live-page{max-width:1000px;margin:auto;padding:3rem 1.5rem 5rem}.live-page h1{color:#193e65;margin-bottom:1rem}.live-body{white-space:pre-wrap;line-height:1.9;margin:2rem 0}.live-media{margin:1.5rem 0}.live-media img,.live-media video{display:block;max-width:100%;max-height:650px;margin:1rem auto}.live-media audio{max-width:100%}.live-media a{display:block;color:#245d89;padding:.8rem;background:#f2f6fa;border-radius:5px}.live-meta{color:#6b7d8e;font-size:.85rem}.live-new-heading{font-size:1.2rem;color:#214d72;margin-bottom:1rem}.live-new-posts{list-style:none;margin-bottom:2rem}.live-new-posts a{display:block;padding:1rem;border-bottom:1px solid #dce5ed;color:#315c7c}</style>
