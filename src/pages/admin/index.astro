---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="관리자 - 해인교회">
  <main class="admin-wrap">
    <section class="local-site" hidden id="localSiteManager"><h2>홈페이지 전체 관리</h2><p>이 컴퓨터에서 메뉴, 안내 페이지, 모든 게시판의 글과 첨부파일을 관리합니다.</p><a href="/admin/site/">메뉴·게시글·자료 관리 →</a></section>
    <p id="adminStatus" role="status" aria-live="polite">관리자 권한 확인 중...</p>
    <div id="adminContent" hidden>
    <div class="admin-header">
      <h1>관리자 페이지</h1>
      <div>
        <span id="userEmail" class="user-email"></span>
        <button id="logoutBtn">로그아웃</button>
      </div>
    </div>

    <!-- 메뉴 -->
    <div class="card-grid">
      <a href="/admin/news-new" class="admin-card">
        <div class="icon">📰</div>
        <h2>소식 작성</h2>
        <p>교회 소식 및 공지사항을 작성합니다</p>
      </a>
      <a href="/admin/gallery-new" class="admin-card">
        <div class="icon">🖼️</div>
        <h2>갤러리 사진 올리기</h2>
        <p>교회 사진을 갤러리에 업로드합니다</p>
      </a>
      <a href="/news" class="admin-card view">
        <div class="icon">👁️</div>
        <h2>소식 목록 보기</h2>
        <p>작성된 소식을 확인합니다</p>
      </a>
      <a href="/gallery" class="admin-card view">
        <div class="icon">🏛️</div>
        <h2>갤러리 보기</h2>
        <p>업로드된 사진을 확인합니다</p>
      </a>
    </div>

    <!-- 가입 신청 목록 -->
    <div class="requests-section">
      <div class="requests-header">
        <h2>회원가입 승인 관리</h2>
        <span id="pendingBadge" class="badge hidden"></span>
      </div>
      <p class="review-help">이름과 가입 인사를 확인한 뒤 승인해 주세요. 승인 결과는 회원의 ‘내 가입 상태’에 반영됩니다.</p>
      <div class="review-tools"><label>처리 상태 <select id="statusFilter"><option value="pending">승인 대기</option><option value="approved">승인 완료</option><option value="rejected">승인 거절</option><option value="all">전체</option></select></label><button id="refreshRequests" type="button">새로고침</button></div>
      <p id="reviewMessage" role="status" aria-live="polite"></p>
      <div id="requestsList" aria-live="polite">
        <p class="loading">불러오는 중...</p>
      </div>
    </div>
    </div>
  </main>
</Layout>

<script>
  if (import.meta.env.DEV && location.hostname==='127.0.0.1') document.getElementById('localSiteManager')!.hidden=false;
  import { membershipClient, connectionMessage, requireAdministrator, membershipStatus } from '../../lib/membership';
  import type { MembershipStatus } from '../../lib/membership';

  const status = document.getElementById('adminStatus')!;
  const content = document.getElementById('adminContent')!;
  const container = document.getElementById('requestsList')!;
  const badge = document.getElementById('pendingBadge')!;
  const message = document.getElementById('reviewMessage')!;
  const filter = document.getElementById('statusFilter') as HTMLSelectElement;
  type JoinRequest = { id: string; name: string; email: string; message: string; status: MembershipStatus; created_at: string; reviewed_at: string | null };
  let requests: JoinRequest[] = [];
  let busy = false;

  // User content is rendered with textContent, never HTML interpolation.
  function text(tag: string, value: string, className: string) {
    const element = document.createElement(tag);
    element.textContent = value; element.className = className; return element;
  }
  function render() {
    const pending = requests.filter(r => r.status === 'pending').length;
    badge.textContent = `대기 ${pending}건`; badge.classList.toggle('hidden', pending === 0);
    container.replaceChildren();
    const visible = requests.filter(r => filter.value === 'all' || r.status === filter.value);
    if (!visible.length) { container.append(text('p', '해당 상태의 가입 신청이 없습니다.', 'empty')); return; }
    for (const request of visible) {
      const row = document.createElement('div'); row.className = `request-item ${request.status}`;
      const info = document.createElement('div'); info.className = 'request-info';
      info.append(text('div', request.name, 'request-name'), text('div', request.email, 'request-email'));
      if (request.message) info.append(text('div', request.message, 'request-msg'));
      info.append(text('div', `신청: ${new Date(request.created_at).toLocaleString('ko-KR')}`, 'request-date'));
      if (request.reviewed_at) info.append(text('div', `처리: ${new Date(request.reviewed_at).toLocaleString('ko-KR')}`, 'request-date'));
      const actions = document.createElement('div'); actions.className = 'request-actions';
      actions.append(text('span', membershipStatus[request.status] ?? '상태 확인 필요', `status-badge ${request.status}`));
      if (request.status === 'pending') {
        for (const decision of ['approved', 'rejected'] as const) {
          const button = document.createElement('button'); button.type = 'button';
          button.className = decision === 'approved' ? 'btn-approve' : 'btn-reject';
          button.textContent = decision === 'approved' ? '승인 완료' : '거절';
          button.disabled = busy;
          button.addEventListener('click', () => review(request, decision)); actions.append(button);
        }
      }
      row.append(info, actions); container.append(row);
    }
  }
  async function loadRequests() {
    const client = await membershipClient();
    if (!client) throw new Error(connectionMessage);
    // RLS additionally restricts this list to designated administrators.
    const { data, error } = await client.from('join_requests')
      .select('id,name,email,message,status,created_at,reviewed_at').order('created_at', { ascending: false });
    if (error) throw new Error('신청 목록을 불러오지 못했습니다. 연결 및 관리자 권한을 확인해 주세요.');
    requests = data ?? []; render();
  }
  async function review(request: JoinRequest, decision: 'approved' | 'rejected') {
    if (busy || !confirm(`${request.name}님의 가입 신청을 ${decision === 'approved' ? '승인' : '거절'}하시겠습니까?`)) return;
    busy = true; render(); message.textContent = '처리 중...';
    try {
      const client = await membershipClient();
      if (!client) throw new Error(connectionMessage);
      const { error } = await client.rpc('review_join_request', { request_id: String(request.id), decision });
      if (error) throw new Error(['42501','22023','40001','P0002'].includes(error.code) ? error.message : '처리하지 못했습니다. 목록을 새로고침한 뒤 다시 시도해 주세요.');
      message.textContent = `${request.name}님 ${membershipStatus[decision]}.`;
      await loadRequests();
    } catch (error) { message.textContent = error instanceof Error ? error.message : '연결하지 못했습니다. 다시 시도해 주세요.'; }
    finally { busy = false; render(); }
  }
  async function initialize() {
    try {
      const client = await membershipClient();
      if (!client) { status.textContent = connectionMessage; return; }
      if (!await requireAdministrator(client)) return;
      const { data: { user } } = await client.auth.getUser();
      document.getElementById('userEmail')!.textContent = user?.email ?? '';
      status.hidden = true; content.hidden = false;
      await loadRequests();
      filter.addEventListener('change', render);
      document.getElementById('refreshRequests')!.addEventListener('click', async () => {
        if (busy) return;
        try { await loadRequests(); message.textContent = '목록을 새로고침했습니다.'; }
        catch { message.textContent = '목록을 새로고침하지 못했습니다. 다시 시도해 주세요.'; }
      });
      document.getElementById('logoutBtn')!.addEventListener('click', async () => {
        const { error } = await client.auth.signOut();
        if (error) { message.textContent = '로그아웃하지 못했습니다. 다시 시도해 주세요.'; return; }
        window.location.replace('/');
      });
    } catch (error) { status.hidden = false; status.textContent = error instanceof Error ? error.message : '연결하지 못했습니다.'; }
  }
  initialize();
</script>

<style is:global>
  .local-site{background:#edf3fa;border:1px solid #cbdaea;padding:1.5rem;border-radius:10px;margin-bottom:2rem;line-height:1.8}.local-site h2{font-size:1.3rem;color:#193e65}.local-site p{font-size:.9rem;color:#5d7188;margin:.5rem 0}.local-site a{color:#1a4fa0;font-weight:700}
  [hidden] {display:none !important}
  .review-help {font-size:.9rem;color:#64748b;line-height:1.7;margin-bottom:1rem}
  .review-tools {display:flex;gap:1rem;align-items:center;margin-bottom:1rem;flex-wrap:wrap}
  .review-tools select,.review-tools button {padding:.5rem;border:1px solid #cbd5e1;border-radius:6px;background:white}
  #reviewMessage {margin:.8rem 0;color:#1a4fa0}
  .request-msg {white-space:pre-wrap;overflow-wrap:anywhere}
  .admin-wrap { max-width: 960px; margin: 0 auto; padding: 3rem 2rem; }
  .admin-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;
  }
  .admin-header h1 { font-size: 1.8rem; color: #1a2a4a; }
  .user-email { font-size: 0.9rem; color: #666; margin-right: 1rem; }
  #logoutBtn {
    padding: 0.5rem 1.2rem; background: #f1f5f9; border: 1px solid #ddd;
    border-radius: 8px; cursor: pointer; font-size: 0.9rem;
  }
  #logoutBtn:hover { background: #e2e8f0; }

  .card-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem; margin-bottom: 3rem;
  }
  .admin-card {
    background: #fff; border-radius: 16px; padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    border: 2px solid transparent; transition: border 0.2s, transform 0.2s;
    text-align: center;
  }
  .admin-card:hover { border-color: #1a4fa0; transform: translateY(-2px); }
  .admin-card.view { background: #f7f9ff; }
  .icon { font-size: 2.5rem; margin-bottom: 0.8rem; }
  .admin-card h2 { font-size: 1.1rem; color: #1a2a4a; margin-bottom: 0.4rem; }
  .admin-card p { font-size: 0.85rem; color: #666; }

  /* 가입신청 */
  .requests-section { background: #fff; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
  .requests-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .requests-header h2 { font-size: 1.3rem; color: #1a2a4a; }
  .badge { background: #dc2626; color: #fff; font-size: 0.75rem; padding: 0.2rem 0.7rem; border-radius: 20px; font-weight: 600; }
  .badge.hidden { display: none; }
  .loading, .empty { color: #888; text-align: center; padding: 2rem; }

  .request-item {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 1.2rem; border-radius: 10px; margin-bottom: 0.8rem;
    border: 1px solid #eee; gap: 1rem; flex-wrap: wrap;
  }
  .request-item.pending { border-left: 4px solid #f59e0b; background: #fffbeb; }
  .request-item.approved { border-left: 4px solid #16a34a; background: #f0fdf4; }
  .request-item.rejected { border-left: 4px solid #dc2626; background: #fef2f2; opacity: 0.7; }
  .request-name { font-weight: 700; color: #1a2a4a; font-size: 1rem; }
  .request-email { color: #1a4fa0; font-size: 0.9rem; margin: 0.2rem 0; }
  .request-msg { color: #666; font-size: 0.85rem; font-style: italic; margin: 0.3rem 0; }
  .request-date { color: #aaa; font-size: 0.8rem; }
  .request-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .status-badge { font-size: 0.8rem; padding: 0.25rem 0.7rem; border-radius: 20px; font-weight: 600; }
  .status-badge.pending { background: #fef3c7; color: #92400e; }
  .status-badge.approved { background: #dcfce7; color: #15803d; }
  .status-badge.rejected { background: #fee2e2; color: #991b1b; }
  .btn-approve, .btn-reject {
    padding: 0.4rem 0.9rem; border: none; border-radius: 6px;
    font-size: 0.85rem; font-weight: 600; cursor: pointer;
  }
  .btn-approve { background: #1a4fa0; color: #fff; }
  .btn-approve:hover { background: #0d2d6b; }
  .btn-approve:disabled { background: #aaa; cursor: not-allowed; }
  .btn-reject { background: #fee2e2; color: #dc2626; }
  .btn-reject:hover { background: #fecaca; }
</style>
