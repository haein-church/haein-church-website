---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="관리자 - 해인교회">
  <main class="admin-wrap">
    <div class="admin-header">
      <h1>관리자 페이지</h1>
      <div>
        <span id="userEmail" class="user-email"></span>
        <button id="logoutBtn">로그아웃</button>
      </div>
    </div>

    <!-- 메뉴 -->
    <div class="card-grid">
      <a href="/admin/news-new" class="admin-card">
        <div class="icon">📰</div>
        <h2>소식 작성</h2>
        <p>교회 소식 및 공지사항을 작성합니다</p>
      </a>
      <a href="/admin/gallery-new" class="admin-card">
        <div class="icon">🖼️</div>
        <h2>갤러리 사진 올리기</h2>
        <p>교회 사진을 갤러리에 업로드합니다</p>
      </a>
      <a href="/news" class="admin-card view">
        <div class="icon">👁️</div>
        <h2>소식 목록 보기</h2>
        <p>작성된 소식을 확인합니다</p>
      </a>
      <a href="/gallery" class="admin-card view">
        <div class="icon">🏛️</div>
        <h2>갤러리 보기</h2>
        <p>업로드된 사진을 확인합니다</p>
      </a>
    </div>

    <!-- 가입 신청 목록 -->
    <div class="requests-section">
      <div class="requests-header">
        <h2>가입 신청 목록</h2>
        <span id="pendingBadge" class="badge hidden"></span>
      </div>
      <div id="requestsList">
        <p class="loading">불러오는 중...</p>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const EDGE_URL = import.meta.env.PUBLIC_SUPABASE_URL.replace('.supabase.co', '.supabase.co/functions/v1/approve-member');

  supabase.auth.getSession().then(({ data }) => {
    if (!data.session) { window.location.href = '/login'; return; }
    const emailEl = document.getElementById('userEmail');
    if (emailEl) emailEl.textContent = data.session.user.email ?? '';
    loadRequests(data.session.access_token);
  });

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  async function loadRequests(token: string) {
    const container = document.getElementById('requestsList') as HTMLDivElement;
    const badge = document.getElementById('pendingBadge') as HTMLSpanElement;

    const { data, error } = await supabase
      .from('join_requests')
      .select('*')
      .order('created_at', { ascending: false });

    if (error || !data || data.length === 0) {
      container.innerHTML = '<p class="empty">신청 내역이 없습니다.</p>';
      return;
    }

    const pending = data.filter((r: any) => r.status === 'pending');
    if (pending.length > 0) {
      badge.textContent = `대기 ${pending.length}건`;
      badge.classList.remove('hidden');
    }

    container.innerHTML = data.map((r: any) => `
      <div class="request-item ${r.status}">
        <div class="request-info">
          <div class="request-name">${r.name}</div>
          <div class="request-email">${r.email}</div>
          ${r.message ? `<div class="request-msg">"${r.message}"</div>` : ''}
          <div class="request-date">${new Date(r.created_at).toLocaleDateString('ko-KR')}</div>
        </div>
        <div class="request-actions">
          <span class="status-badge ${r.status}">${
            r.status === 'pending' ? '대기중' :
            r.status === 'approved' ? '승인됨' : '거절됨'
          }</span>
          ${r.status === 'pending' ? `
            <button class="btn-approve" data-id="${r.id}" data-email="${r.email}" data-name="${r.name}">✓ 승인</button>
            <button class="btn-reject" data-id="${r.id}">✕ 거절</button>
          ` : ''}
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.btn-approve').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        const email = btn.getAttribute('data-email')!;
        const name = btn.getAttribute('data-name')!;
        btn.textContent = '처리 중...';
        (btn as HTMLButtonElement).disabled = true;

        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch(EDGE_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${session?.access_token}`,
          },
          body: JSON.stringify({ id, email, name }),
        });

        if (res.ok) {
          alert(`${name}님께 초대 이메일을 발송했습니다.`);
          loadRequests(session?.access_token ?? '');
        } else {
          const err = await res.json();
          alert('오류: ' + (err.error || '알 수 없는 오류'));
          btn.textContent = '✓ 승인';
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });

    container.querySelectorAll('.btn-reject').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        if (!confirm('거절하시겠습니까?')) return;
        await supabase.from('join_requests').update({ status: 'rejected' }).eq('id', id);
        const { data: { session } } = await supabase.auth.getSession();
        loadRequests(session?.access_token ?? '');
      });
    });
  }
</script>

<style>
  .admin-wrap { max-width: 960px; margin: 0 auto; padding: 3rem 2rem; }
  .admin-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;
  }
  .admin-header h1 { font-size: 1.8rem; color: #1a2a4a; }
  .user-email { font-size: 0.9rem; color: #666; margin-right: 1rem; }
  #logoutBtn {
    padding: 0.5rem 1.2rem; background: #f1f5f9; border: 1px solid #ddd;
    border-radius: 8px; cursor: pointer; font-size: 0.9rem;
  }
  #logoutBtn:hover { background: #e2e8f0; }

  .card-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem; margin-bottom: 3rem;
  }
  .admin-card {
    background: #fff; border-radius: 16px; padding: 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    border: 2px solid transparent; transition: border 0.2s, transform 0.2s;
    text-align: center;
  }
  .admin-card:hover { border-color: #1a4fa0; transform: translateY(-2px); }
  .admin-card.view { background: #f7f9ff; }
  .icon { font-size: 2.5rem; margin-bottom: 0.8rem; }
  .admin-card h2 { font-size: 1.1rem; color: #1a2a4a; margin-bottom: 0.4rem; }
  .admin-card p { font-size: 0.85rem; color: #666; }

  /* 가입신청 */
  .requests-section { background: #fff; border-radius: 16px; padding: 2rem; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
  .requests-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .requests-header h2 { font-size: 1.3rem; color: #1a2a4a; }
  .badge { background: #dc2626; color: #fff; font-size: 0.75rem; padding: 0.2rem 0.7rem; border-radius: 20px; font-weight: 600; }
  .badge.hidden { display: none; }
  .loading, .empty { color: #888; text-align: center; padding: 2rem; }

  .request-item {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 1.2rem; border-radius: 10px; margin-bottom: 0.8rem;
    border: 1px solid #eee; gap: 1rem; flex-wrap: wrap;
  }
  .request-item.pending { border-left: 4px solid #f59e0b; background: #fffbeb; }
  .request-item.approved { border-left: 4px solid #16a34a; background: #f0fdf4; }
  .request-item.rejected { border-left: 4px solid #dc2626; background: #fef2f2; opacity: 0.7; }
  .request-name { font-weight: 700; color: #1a2a4a; font-size: 1rem; }
  .request-email { color: #1a4fa0; font-size: 0.9rem; margin: 0.2rem 0; }
  .request-msg { color: #666; font-size: 0.85rem; font-style: italic; margin: 0.3rem 0; }
  .request-date { color: #aaa; font-size: 0.8rem; }
  .request-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .status-badge { font-size: 0.8rem; padding: 0.25rem 0.7rem; border-radius: 20px; font-weight: 600; }
  .status-badge.pending { background: #fef3c7; color: #92400e; }
  .status-badge.approved { background: #dcfce7; color: #15803d; }
  .status-badge.rejected { background: #fee2e2; color: #991b1b; }
  .btn-approve, .btn-reject {
    padding: 0.4rem 0.9rem; border: none; border-radius: 6px;
    font-size: 0.85rem; font-weight: 600; cursor: pointer;
  }
  .btn-approve { background: #1a4fa0; color: #fff; }
  .btn-approve:hover { background: #0d2d6b; }
  .btn-approve:disabled { background: #aaa; cursor: not-allowed; }
  .btn-reject { background: #fee2e2; color: #dc2626; }
  .btn-reject:hover { background: #fecaca; }
</style>
