---
import Layout from '../layouts/Layout.astro';
import BoardPreview from '../components/BoardPreview.astro';
import HeroSlides from '../components/HeroSlides.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { groups, postsFor, postUrl, pages } from '../lib/onmam';
const moments = postsFor('25').filter(post => post.images.length).slice(0,3);
const churchImage = pages.find(page => page.id === '2')?.images[0];
---
<Layout title="해인교회 · 하나님을 사랑하고 이웃을 섬기는 교회">
 <main>
  <HeroSlides/>
  <HeroSlider/>
  <section class="welcome-strip" aria-label="예배 안내 요약"><div class="welcome-strip-inner"><p><span class="eyebrow">예배에 초대합니다</span> 주일예배 <strong>오전 11:00</strong> · 인천 계양구 계양산로 91</p><div class="hero-actions"><a class="solid" href="/about/">해인교회 소개 →</a><a class="outline" href="/contact/">처음 오시는 분께</a><a class="outline" href="/boards/19/">새가족반 알아보기 →</a></div></div></section>
  <nav class="quick" aria-label="자주 찾는 메뉴"><a href="/services/"><span>01</span>예배안내 <b>↗</b></a><a href="/boards/13/"><span>02</span>주일설교 <b>↗</b></a><a href="/boards/51/"><span>03</span>주보 <b>↗</b></a><a href="/contact/"><span>04</span>오시는 길 <b>↗</b></a></nav>
  <section class="section"><div class="section-title"><div><p class="eyebrow">말씀과 교회의 소식</p><h2>함께 나누는 이야기</h2></div><a href="/sections/news/">교회소식 전체보기 →</a></div><div class="board-grid"><BoardPreview id="13" title="주일설교 BMP"/><BoardPreview id="51" title="주보"/><BoardPreview id="55" title="교회소식"/><BoardPreview id="57" title="사회복지선교사역"/></div></section>
  <section class="mission"><div class="mission-inner"><div class="mission-image">{churchImage && <img src={churchImage} alt="해인교회 소개 사진" loading="lazy"/>}</div><div class="mission-copy"><p class="eyebrow">믿음을 삶으로</p><h2>이웃과 함께<br/>하나님 나라를 가꾸어 갑니다.</h2><p>가난한 이웃을 섬기고, 인간과 자연의 생명을 소중히 여기며,<br/>더불어 사는 공동체를 꿈꿉니다.</p><a href="/sections/mission/">선교사역 만나보기 →</a></div></div></section>
  <section class="section"><div class="section-title"><div><p class="eyebrow">함께 자라는 공동체</p><h2>교회의 일상</h2></div><a href="/sections/departments/">부서소개 전체보기 →</a></div><div class="moments">{moments.map(post => <a href={postUrl(post)}><div class="photo"><img src={post.images[0]} alt="" loading="lazy"/></div><p class="moment-board">{post.boardName}</p><h3>{post.title}</h3><time datetime={post.date ?? undefined}>{post.date}</time></a>)}</div></section>
  <section class="community"><div class="section"><div class="section-title"><div><p class="eyebrow">교회 안에서 함께</p><h2>찬양하고 배우고 나누는 삶</h2></div><a href="/boards/">모든 메뉴 보기 →</a></div><div class="group-grid">{groups.filter(group => ['praise','training','groups','community'].includes(group.slug)).map(group => <a href={`/sections/${group.slug}/`}><h3>{group.name} <span>→</span></h3><p>{group.description}</p><small>{group.children.map(item => item.name).slice(0,3).join(' · ')}</small></a>)}</div></div></section>
 </main>
</Layout>
<style>
 .eyebrow{font-size:.76rem;letter-spacing:.13em;font-weight:700;color:#8d6c40;margin-bottom:1rem}.hero{background:#edf2f6;border-bottom:1px solid #dce4eb}.hero-inner{max-width:1200px;margin:auto;padding:5.5rem 1.5rem;display:grid;grid-template-columns:1.7fr 1fr;gap:4rem;align-items:center}.hero h1{font-size:clamp(2rem,4vw,3.2rem);font-weight:600;letter-spacing:-.065em;line-height:1.45;color:#183c5d}.intro{margin-top:1.5rem;font-size:.98rem;line-height:1.95;color:#52677d}.hero-actions{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}.hero-actions a{padding:.9rem 1.25rem;border-radius:4px;font-size:.86rem}.solid{background:#204d73;color:white}.outline{border:1px solid #8da4b9;color:#244d70}.welcome{background:#fff;padding:2.2rem;border-top:3px solid #ad8550;box-shadow:0 12px 35px #193e6510}.welcome h2{font-weight:400;font-size:1.1rem;color:#284d6d}.welcome strong{display:block;margin:.7rem 0 1.5rem;font-size:2rem;letter-spacing:-.04em}.welcome>p:not(.eyebrow){font-size:.85rem;color:#6b7c8e;margin-bottom:1.5rem}.welcome a{display:block;border-top:1px solid #e5ebf0;padding:.9rem 0;font-size:.85rem;color:#28567e}.quick{display:grid;grid-template-columns:repeat(4,1fr);max-width:1152px;margin:0 auto;border-bottom:1px solid #dfe6ed}.quick a{display:flex;align-items:center;gap:.9rem;padding:1.7rem 1.2rem;font-size:.95rem;border-right:1px solid #dfe6ed}.quick a:last-child{border:0}.quick span{font-size:.68rem;color:#a08053}.quick b{margin-left:auto;color:#a08053;font-weight:400}.quick a:hover{background:#f6f8fa}.section{max-width:1200px;margin:auto;padding:4.5rem 1.5rem}.section-title{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:2.5rem}.section-title .eyebrow{margin-bottom:.7rem}.section-title h2{font-size:1.9rem;font-weight:600;letter-spacing:-.05em;color:#193e65}.section-title>a{color:#456885;font-size:.82rem}.board-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem 3.5rem}.mission{background:#f5f3ee}.mission-inner{max-width:1200px;margin:auto;display:grid;grid-template-columns:1fr 1.15fr;gap:4rem;align-items:center;padding:4rem 1.5rem}.mission-image{height:320px;overflow:hidden;background:#d8e1e8;border-radius:4px}.mission-image img{width:100%;height:100%;object-fit:cover}.mission-copy h2{font-size:clamp(1.6rem,3vw,2.2rem);font-weight:600;letter-spacing:-.055em;line-height:1.5;color:#193e65}.mission-copy>p:not(.eyebrow){line-height:1.9;font-size:.9rem;color:#627080;margin:1.3rem 0}.mission-copy>a{color:#315f80;font-size:.88rem;font-weight:700}.moments{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.photo{aspect-ratio:4/3;overflow:hidden;border-radius:5px;background:#edf2f6}.photo img{width:100%;height:100%;object-fit:cover}.moment-board{color:#967344;font-size:.76rem;margin:1rem 0 .5rem}.moments h3{font-size:1rem;font-weight:600;line-height:1.6}.moments time{display:block;color:#6c7e91;font-size:.76rem;margin-top:.5rem}.community{background:#f6f8fa}.group-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.group-grid>a{border:1px solid #dce5ed;padding:1.5rem;background:white;border-radius:5px}.group-grid h3{font-size:1.12rem;color:#214e72}.group-grid h3 span{float:right;color:#a28357}.group-grid p{font-size:.85rem;line-height:1.8;color:#627389;margin:1rem 0}.group-grid small{font-size:.7rem;color:#65788e;line-height:1.8}.welcome-strip{background:#edf2f6;border-bottom:1px solid #dce4eb;padding:1.6rem 1.5rem}.welcome-strip-inner{max-width:1200px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:1.2rem;flex-wrap:wrap}.welcome-strip p{font-size:.95rem;color:#183c5d}.welcome-strip strong{color:#183c5d;font-size:1.05rem}.welcome-strip .eyebrow{margin:0 .6rem 0 0;display:inline}.welcome-strip .hero-actions{margin-top:0}@media(max-width:800px){.welcome-strip-inner{flex-direction:column;align-items:flex-start}}@media(max-width:800px){.hero-inner{grid-template-columns:1fr;padding:3rem 1.2rem;gap:2rem}.welcome{padding:1.5rem}.welcome strong{font-size:1.6rem}.quick{grid-template-columns:repeat(2,1fr)}.quick a{border-bottom:1px solid #dfe6ed;padding:1.2rem}.board-grid{grid-template-columns:1fr;gap:2.5rem}.section{padding:3rem 1.2rem}.mission-inner{grid-template-columns:1fr;gap:2rem;padding:3rem 1.2rem}.mission-image{height:260px}.group-grid{grid-template-columns:1fr 1fr}.moments{grid-template-columns:1fr}.section-title{align-items:start}.section-title h2{font-size:1.55rem}.section-title>a{max-width:100px;line-height:1.7}.mission-copy br{display:none}}
 @media(max-width:480px){.section{padding:2.5rem 1rem}.section-title{flex-direction:column;align-items:flex-start;gap:.8rem;margin-bottom:1.6rem}.section-title>a{max-width:none}.group-grid{grid-template-columns:1fr}.board-grid{gap:2rem}.welcome-strip{padding:1.2rem 1rem}.welcome-strip .hero-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;gap:.6rem}.welcome-strip .hero-actions a{display:flex;align-items:center;justify-content:center;min-height:44px;text-align:center;padding:.7rem .5rem;font-size:.8rem}.welcome-strip .hero-actions a:last-child:nth-child(odd){grid-column:1/-1}.quick a{min-height:64px;padding:1rem}.mission-inner{padding:2.5rem 1rem}.mission-image{height:220px}}
</style>
